<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS discovery (NsdManager) needs no special permission, but on
         Android 12+ the system warns the user about NSD usage. -->

    <!-- Hardware services. RECORD_AUDIO is requested at runtime by the
         mic toggle in the Dashboard. CAMERA is requested at runtime by
         ConnectedShell when the device pushes a CameraStartViewfinderEvent. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- ACCESS_WIFI_STATE is a normal permission (granted at install).
         ACCESS_FINE_LOCATION is requested at runtime by the Wi-Fi QR code
         screen — WifiManager.connectionInfo only returns the real SSID
         (instead of "<unknown ssid>") when it's granted. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".UboPhoneApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UboApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.UboApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Glance home-screen widget. The receiver lives in the
             :widget-app library; the appwidget metadata is bundled
             with that module and merged into this app. -->
        <receiver
            android:name="com.ubopod.uboapp.widget.UboWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ubo_widget_info" />
        </receiver>
    </application>
</manifest>
